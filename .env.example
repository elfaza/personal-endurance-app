# Copy to .env.local. Restart the server after changes. Never commit real secrets.
# Demo data is isolated from Garmin and Google Sheets.
PE_DATA_MODE=demo

# Required in live mode, production, or when accessing over your network.
# Choose a strong password (at least 16 characters) and random secret (at least 32).
APP_PASSWORD=
SESSION_SECRET=
# Exact origin of the browser app. Use your HTTPS origin when deploying.
APP_ORIGIN=http://localhost:3107

# Official Garmin Connect Personal API key. Never use NEXT_PUBLIC_ for credentials.
GARMIN_PERSONAL_API_KEY=

# Direct Google OAuth. Enable Sheets API; use a Web application OAuth client.
GOOGLE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connect from /settings/google and copy the masked token directly into Vercel.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WRITES_ENABLED=true

# Optional: authenticated GET /api/sync for an external scheduler (32+ random characters).
CRON_SECRET=
